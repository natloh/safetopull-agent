    {
      "version": "v2.0.0",
      "semver": [2, 0, 0],
      "published_at": "2026-09-15T12:00:00Z",
      "is_breaking": true,
      "database_migration": true,
      "minimum_prior_version": "v1.133.0",
      "required_cpu_flags": ["avx2"],
      "summary": "Migrates vector extension from pgvecto.rs to VectorChord and updates container upload target to /data.",
      "arch_readiness": {
        "official": { "amd64": true, "arm64": true }
      },
      "rules": [
        {
          "rule_slug": "immich-v2-vectorchord-swap",
          "severity": "blocking",
          "category": "companion_image_change",
          "condition": {
            "type": "companion_service_image_matches",
            "service": "database",
            "pattern": "*pgvecto-rs*"
          },
          "action": {
            "type": "replace_companion_image",
            "service": "database",
            "from_image": "tensorchord/pgvecto-rs:pg14-v0.2.0",
            "to_image": "ghcr.io/immich-app/postgres:16-vectorchord0.3.0"
          },
          "explanation": "Immich v2.0 replaces pgvecto-rs with VectorChord."
        },
        {
          "rule_slug": "immich-v2-volume-target",
          "severity": "blocking",
          "category": "volume_path_change",
          "condition": {
            "type": "always"
          },
          "action": {
            "type": "update_volume_target",
            "service": "immich-server",
            "from_target": "/usr/src/app/upload",
            "to_target": "/data"
          },
          "explanation": "Container upload path moved from /usr/src/app/upload to /data."
        },
        {
          "rule_slug": "immich-v2-env-postgres-host",
          "severity": "warning",
          "category": "env_var_renamed",
          "condition": {
            "type": "env_key_present",
            "key": "DB_HOSTNAME"
          },
          "action": {
            "type": "rename_env_key",
            "from_key": "DB_HOSTNAME",
            "to_key": "POSTGRES_HOST"
          },
          "explanation": "DB_HOSTNAME has been renamed to POSTGRES_HOST."
        }
      ]
    }
  ]
